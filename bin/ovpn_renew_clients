#!/bin/bash
set -e

# Renew VPN client certificates
# Usage: ovpn_renew_clients <client-name> [additional-client-names...]

if [ $# -eq 0 ]; then
    echo "Usage: renew-clients <client-name> [client-name-2...]"
    echo ""
    echo "Examples:"
    echo "  renew-clients alice"
    echo "  renew-clients alice bob"
    exit 1
fi

# EasyRSA does NOT infer its PKI location from the current directory -
# it resolves EASYRSA_PKI from $EASYRSA/pki by default (EasyRSA's own
# install dir), not from cwd. Without exporting this explicitly,
# EASYRSA_TEMP_DIR (which defaults to EASYRSA_PKI) points at a
# directory that doesn't exist, its temp-session setup gets silently
# skipped, and the first easyrsa_mktemp call dies with:
#   "easyrsa_mktemp - Temporary session undefined (--tmp-dir)"
export EASYRSA_PKI="/etc/openvpn/pki"
export EASYRSA="/usr/local/easyrsa/easyrsa3"
cd /etc/openvpn/pki

for CLIENT in "$@"; do
    if [ ! -f "issued/${CLIENT}.crt" ]; then
        echo "⚠️  Certificate not found for client: $CLIENT"
        continue
    fi
    
    echo "🔄 Renewing certificate for client: $CLIENT"
    
    # Renew certificate (revoke old, create new request, sign new)
    /usr/local/bin/easyrsa --batch renew "$CLIENT" nopass
    
    echo "✅ Client certificate renewed: $CLIENT"
done

echo ""
echo "✅ All client certificates renewed successfully"
echo ""
echo "💡 Tip: Clients will need to restart their VPN connections to use the new certificate"
