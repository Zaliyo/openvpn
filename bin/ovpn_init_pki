#!/bin/bash
set -e

# Initialize OpenVPN PKI (Certificates and Keys)
# Standalone convenience script for first-time setup

echo "🔐 Initializing OpenVPN PKI..."

# Set EasyRSA environment
export EASYRSA_PKI="/etc/openvpn/pki"
export EASYRSA="/usr/local/easyrsa/easyrsa3"

# Check if already initialized
if [ -f "${EASYRSA_PKI}/ca.crt" ]; then
    echo "⚠️  PKI already initialized at ${EASYRSA_PKI}"
    echo "Run 'docker exec openvpn easyrsa ...' for additional operations"
    exit 0
fi

# IMPORTANT: do NOT pre-create EASYRSA_PKI here. easyrsa's own
# init-pki only runs `rm -rf "$EASYRSA_PKI"` when that directory
# ALREADY exists (it creates it fresh via mkdir -p otherwise). If we
# mkdir it ourselves first, we force that remove-then-recreate branch
# on every single run - including a brand-new, empty volume - and
# easyrsa's internal `rm -rf ... || die` has no retry, so it dies
# outright on any transient "Device or resource busy" from the
# storage/bind-mount backend.
#
# So: only touch EASYRSA_PKI ourselves if a stale/incomplete directory
# is left over from an earlier failed run (we already know ca.crt is
# missing at this point), and do that removal with retries of our own.
if [ -d "${EASYRSA_PKI}" ]; then
    echo "⚠️  Found a leftover/incomplete PKI directory at ${EASYRSA_PKI} - removing it before re-initializing..."
    removed=""
    for attempt in 1 2 3 4 5; do
        if rm -rf "${EASYRSA_PKI}" 2>/tmp/ovpn_init_pki_rm_err; then
            removed=1
            break
        fi
        echo "   rm -rf busy (attempt ${attempt}/5), retrying in 2s..."
        sleep 2
    done
    if [ -z "$removed" ]; then
        echo ""
        echo "❌ ERROR: could not remove stale PKI directory at ${EASYRSA_PKI} after 5 attempts:"
        cat /tmp/ovpn_init_pki_rm_err 2>/dev/null
        echo ""
        echo "Something still has a file open under that path, or the storage"
        echo "backend behind it is rejecting the removal. On the host, try:"
        echo "  fuser -vm openvpn-data/conf/pki   (or: lsof +D openvpn-data/conf/pki)"
        echo "to find what's holding it, then re-run this init."
        exit 1
    fi
fi

# IMPORTANT: do NOT cd into EASYRSA_PKI (or leave the shell inside it
# while easyrsa recreates it either). Stay outside of it.
cd /tmp

# Use the easyrsa executable from bin (already in PATH)
EASYRSA_BIN="/usr/local/bin/easyrsa"

# Step 1: Initialize PKI
echo "📋 Step 1: Initializing PKI directory structure..."
"${EASYRSA_BIN}" --batch init-pki

# Step 2: Build CA
echo "📋 Step 2: Building Certificate Authority (CA)..."
"${EASYRSA_BIN}" --batch build-ca nopass

# Step 3: Generate server request
echo "📋 Step 3: Generating server certificate request..."
"${EASYRSA_BIN}" --batch gen-req server nopass

# Step 4: Sign server certificate
echo "📋 Step 4: Signing server certificate..."
"${EASYRSA_BIN}" --batch --no-inline sign-req server server

# Step 5: Generate Diffie-Hellman parameters
echo "📋 Step 5: Generating Diffie-Hellman parameters (this may take a moment)..."
"${EASYRSA_BIN}" gen-dh

# Step 6: Generate TLS-Crypt static key
echo "📋 Step 6: Generating TLS-Crypt key..."
/usr/local/sbin/openvpn --genkey secret "${EASYRSA_PKI}/ta.key"

# Verify all files exist
echo ""
echo "✅ PKI Initialization Complete!"
echo ""
echo "Certificates and keys created:"
ls -lh "${EASYRSA_PKI}"/*.crt 2>/dev/null || true
ls -lh "${EASYRSA_PKI}"/*.key 2>/dev/null || true
ls -lh "${EASYRSA_PKI}"/dh.pem 2>/dev/null || true
ls -lh "${EASYRSA_PKI}"/ta.key 2>/dev/null || true

echo ""
echo "📝 Next steps:"
echo "1. Restart container: docker restart openvpn"
echo "2. Create first client: docker exec openvpn create-clients alice"
echo "3. Download client config: cat openvpn-data/users/alice.ovpn"
echo ""
echo "💡 For more clients:"
echo "   docker exec openvpn create-clients bob charlie"
