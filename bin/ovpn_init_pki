#!/bin/bash
set -e

# Initialize OpenVPN PKI (Certificates and Keys)
# Standalone convenience script for first-time setup

echo "🔐 Initializing OpenVPN PKI..."

# Check if already initialized
if [ -f "/etc/openvpn/pki/ca.crt" ]; then
    echo "⚠️  PKI already initialized at /etc/openvpn/pki/"
    echo "Run 'docker exec openvpn easyrsa ...' for additional operations"
    exit 0
fi

# Step 1: Initialize PKI
echo "📋 Step 1: Initializing PKI directory structure..."
/usr/local/bin/easyrsa init-pki

# Step 2: Build CA
echo "📋 Step 2: Building Certificate Authority (CA)..."
/usr/local/bin/easyrsa build-ca nopass

# Step 3: Generate server request
echo "📋 Step 3: Generating server certificate request..."
/usr/local/bin/easyrsa gen-req server nopass

# Step 4: Sign server certificate
echo "📋 Step 4: Signing server certificate..."
/usr/local/bin/easyrsa sign-req server server

# Step 5: Generate Diffie-Hellman parameters
echo "📋 Step 5: Generating Diffie-Hellman parameters (this may take a moment)..."
/usr/local/bin/easyrsa gen-dh

# Step 6: Generate TLS-Crypt static key
echo "📋 Step 6: Generating TLS-Crypt key..."
/usr/local/bin/openvpn --genkey secret /etc/openvpn/pki/ta.key

# Verify all files exist
echo ""
echo "✅ PKI Initialization Complete!"
echo ""
echo "Certificates and keys created:"
ls -lh /etc/openvpn/pki/*.crt 2>/dev/null || true
ls -lh /etc/openvpn/pki/*.key 2>/dev/null || true
ls -lh /etc/openvpn/pki/dh.pem 2>/dev/null || true
ls -lh /etc/openvpn/pki/ta.key 2>/dev/null || true

echo ""
echo "📝 Next steps:"
echo "1. Restart container: docker restart openvpn"
echo "2. Create first client: docker exec openvpn create-clients alice"
echo "3. Download client config: cat openvpn-data/users/alice.ovpn"
echo ""
echo "💡 For more clients:"
echo "   docker exec openvpn create-clients bob charlie"
