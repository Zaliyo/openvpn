#!/bin/bash
# ovpn_getclient - Export client OpenVPN configuration
# Usage: ovpn_getclient <clientname> > clientname.ovpn

set -e

if [[ -z "$1" ]]; then
    echo "Usage: $0 <clientname>"
    echo ""
    echo "Example:"
    echo "  docker-compose run --rm openvpn ovpn_getclient alice > alice.ovpn"
    exit 1
fi

CLIENTNAME="$1"
OPENVPN_DIR="${OPENVPN_DIR:-/etc/openvpn}"
EASYRSA_PKI="${OPENVPN_DIR}/pki"
CONFIG_FILE="${OPENVPN_DIR}/openvpn.conf"

# Validate client certificate exists
if [[ ! -f "${EASYRSA_PKI}/issued/${CLIENTNAME}.crt" ]]; then
    echo "ERROR: Client certificate not found: ${EASYRSA_PKI}/issued/${CLIENTNAME}.crt"
    exit 1
fi

# Validate config file exists
if [[ ! -f "${CONFIG_FILE}" ]]; then
    echo "ERROR: OpenVPN config not found: ${CONFIG_FILE}"
    exit 1
fi

# Extract VPN server address from config
PROTO_URL=$(grep "^proto" "${CONFIG_FILE}" | awk '{print $2}')
PORT=$(grep "^port" "${CONFIG_FILE}" | awk '{print $2}')

# Build client config
cat << EOF
##############################################################################
#                                                                            #
# Sample client-side OpenVPN 2.0 config file                                #
# for connecting to a multi-client, routed VPN.                             #
#                                                                            #
# This configuration can be used by multiple                                #
# clients, however each client should have                                  #
# its own cert and key files.                                               #
#                                                                            #
# On Windows, you might want to rename this                                 #
# file so it has a .ovpn extension                                          #
#                                                                            #
##############################################################################

client

# Which TCP/UDP protocol to use
proto ${PROTO_URL}

# The hostname/IP and port of the server.
remote CHANGE_THIS_TO_SERVERNAME_OR_IP ${PORT}

dev tun
resolv-retry infinite
nobind
persist-key
persist-tun

# Use the same cipher as server
cipher AES-256-GCM

# TLS Settings
remote-cert-tls server
auth SHA256

# Logging
verb 3
mute 20

# Generated by OpenVPN v2.7.7 PKI

<ca>
$(cat "${EASYRSA_PKI}/ca.crt")
</ca>

<cert>
$(cat "${EASYRSA_PKI}/issued/${CLIENTNAME}.crt")
</cert>

<key>
$(cat "${EASYRSA_PKI}/private/${CLIENTNAME}.key")
</key>

<tls-crypt>
$(cat "${EASYRSA_PKI}/ta.key")
</tls-crypt>
EOF
