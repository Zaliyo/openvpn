#!/bin/bash
# ovpn_genconfig - Generate OpenVPN server configuration
# Usage: ovpn_genconfig -u udp://VPN.SERVERNAME.COM

set -e

OPENVPN_DIR="${OPENVPN_DIR:-/etc/openvpn}"
CONFIG_FILE="${OPENVPN_DIR}/openvpn.conf"

# Default values
PROTOCOL="udp"
PORT="1194"
CIPHER="AES-256-GCM"
AUTH="SHA256"
DH_SIZE="2048"
SUBNET="192.168.255.0"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -u|--proto-url)
            PROTO_URL="$2"
            shift 2
            ;;
        -p|--port)
            PORT="$2"
            shift 2
            ;;
        -c|--cipher)
            CIPHER="$2"
            shift 2
            ;;
        -a|--auth)
            AUTH="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Validate PROTO_URL
if [[ -z "${PROTO_URL}" ]]; then
    echo "ERROR: Protocol URL required. Usage: -u udp://VPN.SERVERNAME.COM"
    exit 1
fi

# Parse protocol and hostname from PROTO_URL
if [[ "${PROTO_URL}" =~ ^(tcp|udp)://(.+)$ ]]; then
    PROTOCOL="${BASH_REMATCH[1]}"
    VPN_HOSTNAME="${BASH_REMATCH[2]}"
else
    echo "ERROR: Invalid protocol URL: ${PROTO_URL}"
    echo "Expected format: udp://VPN.SERVERNAME.COM or tcp://VPN.SERVERNAME.COM"
    exit 1
fi

# Create openvpn directory if needed
mkdir -p "${OPENVPN_DIR}"

echo "Generating OpenVPN configuration..."
echo "  Protocol: ${PROTOCOL}"
echo "  Hostname: ${VPN_HOSTNAME}"
echo "  Port: ${PORT}"
echo "  Cipher: ${CIPHER}"
echo "  Config: ${CONFIG_FILE}"

# Generate configuration file
cat > "${CONFIG_FILE}" << EOF
# OpenVPN Server Configuration
# Generated by ovpn_genconfig for official OpenVPN v2.7.7
# Based on https://github.com/OpenVPN/openvpn

port ${PORT}
proto ${PROTOCOL}
dev tun

# Certificates and Keys
ca /etc/openvpn/pki/ca.crt
cert /etc/openvpn/pki/issued/server.crt
key /etc/openvpn/pki/private/server.key
dh /etc/openvpn/pki/dh.pem
tls-crypt /etc/openvpn/pki/ta.key

# Network Configuration
server ${SUBNET} 255.255.255.0
ifconfig-pool-persist ipp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"

# Topology - ensure compatibility across platforms
topology net30

# Performance
keepalive 10 120
user nobody
group nogroup

# Security
cipher ${CIPHER}
auth ${AUTH}
tls-version-min 1.2
tls-version-max 1.3
tls-cipher "DEFAULT:!aNULL:!eNULL:!MD5:!3DES:!DES:!RC4:!IDEA:!SEED:!aDSS:!SRP:!PSK"

# Logging
status /var/log/openvpn/status.log
verb 3
mute 20

# Security hardening
explicit-exit-notify 1

# Use OpenVPN 2.4+ data channel encryption
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
EOF

echo "✓ Configuration generated successfully at ${CONFIG_FILE}"
echo ""
echo "Next step: Initialize the PKI with 'ovpn_initpki'"
