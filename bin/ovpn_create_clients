#!/bin/bash
set -e

# Create new VPN client certificates and matching .ovpn connection files
# Usage: ovpn_create_clients <client-name> [additional-client-names...]

if [ $# -eq 0 ]; then
    echo "Usage: create-clients <client-name> [client-name-2...]"
    echo ""
    echo "Examples:"
    echo "  create-clients alice"
    echo "  create-clients alice bob charlie"
    exit 1
fi

# EasyRSA does NOT infer its PKI location from the current directory -
# it resolves EASYRSA_PKI from $EASYRSA/pki by default (EasyRSA's own
# install dir), not from cwd. Without exporting this explicitly,
# EASYRSA_TEMP_DIR (which defaults to EASYRSA_PKI) points at a
# directory that doesn't exist, its temp-session setup gets silently
# skipped, and the first easyrsa_mktemp call dies with:
#   "easyrsa_mktemp - Temporary session undefined (--tmp-dir)"
export EASYRSA_PKI="/etc/openvpn/pki"
export EASYRSA="/usr/local/easyrsa/easyrsa3"
cd /etc/openvpn/pki

# build_ovpn_file() and its USERS_DIR/SERVER_HOST/SERVER_PORT setup are
# shared with ovpn_renew_clients - see lib_ovpn_client_bundle.sh so the
# two scripts can't drift out of sync again.
. /usr/local/bin/lib_ovpn_client_bundle.sh

for CLIENT in "$@"; do
    echo "📝 Generating certificate request for client: $CLIENT"

    # Generate key and request
    /usr/local/bin/easyrsa --batch gen-req "$CLIENT" nopass

    echo "✍️  Signing certificate for client: $CLIENT"

    # Sign certificate
    /usr/local/bin/easyrsa --batch --no-inline sign-req client "$CLIENT"

    echo "📦 Building ${CLIENT}.ovpn..."
    build_ovpn_file "$CLIENT"

    echo "✅ Client created: $CLIENT -> ${OVPN_USERS_DIR}/${CLIENT}.ovpn"
done

echo ""
echo "✅ All client certificates created successfully"
echo ""
echo "Client .ovpn files: ${OVPN_USERS_DIR}/"
echo "To retrieve a client config from the host, use:"
echo "  docker cp openvpn:${OVPN_USERS_DIR}/\$CLIENT.ovpn ."
echo "(or, if this deployment mounts ${OVPN_USERS_DIR} to a host directory, it's already there)"
