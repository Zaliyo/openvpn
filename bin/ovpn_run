#!/bin/bash
# ovpn_run - Run OpenVPN daemon
# Starts the OpenVPN server

set -e

OPENVPN_DIR="${OPENVPN_DIR:-/etc/openvpn}"
CONFIG_FILE="${OPENVPN_DIR}/openvpn.conf"
LOG_FILE="${LOG_FILE:-/var/log/openvpn/openvpn.log}"

# Ensure log directory exists
mkdir -p "$(dirname "${LOG_FILE}")"

# Check if config exists
if [[ ! -f "${CONFIG_FILE}" ]]; then
    echo "ERROR: ${CONFIG_FILE} not found. Please run 'ovpn_genconfig' first."
    exit 1
fi

# Check if PKI is initialized
if [[ ! -f "${OPENVPN_DIR}/pki/ca.crt" ]]; then
    echo "ERROR: PKI not initialized. Please run 'ovpn_initpki' first."
    exit 1
fi

# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1 > /dev/null 2>&1 || true

# Debug mode
if [[ "${DEBUG}" == "1" ]]; then
    echo "[DEBUG] Starting OpenVPN server..."
    echo "[DEBUG] Configuration: ${CONFIG_FILE}"
    echo "[DEBUG] Log file: ${LOG_FILE}"
    OPENVPN_OPTS="--verb 3 --log-append ${LOG_FILE}"
else
    OPENVPN_OPTS="--log-append ${LOG_FILE}"
fi

echo "Starting OpenVPN Server v2.7.7..."
exec /usr/local/sbin/openvpn --config "${CONFIG_FILE}" ${OPENVPN_OPTS}
