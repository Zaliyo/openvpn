# OpenVPN Server Configuration
# ============================

# Docker image - Replace with your Docker Hub image link
# Format: username/repo:tag or registry.example.com/repo:tag
DOCKER_IMAGE=openvpn:2.7.7

# Container name
CONTAINER_NAME=openvpn

# VPN Server IP (for configuration)
VPN_IP=10.8.0.0

# VPN Port
VPN_PORT=1194

# Debug mode (set to 1 to enable verbose logging)
DEBUG=0
